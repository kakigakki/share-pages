# Git Bash on Windows: winget installs are not on PATH until the shell restarts. Copy to <work>/env.sh, fix paths, then `. ./env.sh`
L=/c/Users/<you>/AppData/Local
export PATH="/c/Program Files/nodejs:$L/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-<ver>-full_build/bin:$L/Programs/ExifTool:$PATH"
export CAPCUT_DRAFTS_DIR="C:/Users/<you>/AppData/Local/CapCut/User Data/Projects/com.lveditor.draft"
